{
  "name": "@pushizo/cli",
  "version": "0.3.0",
  "description": "Pushizo command-line tool: list apps, segments and templates, send notifications",
  "license": "MIT",
  "homepage": "https://docs.pushizo.com/docs/integrations/cli-sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushizo/pushizo-cli.git"
  },
  "bugs": {
    "url": "https://github.com/pushizo/pushizo-cli/issues",
    "email": "support@pushizo.com"
  },
  "keywords": [
    "pushizo",
    "cli",
    "push",
    "notifications",
    "command-line"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "pushizo": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
